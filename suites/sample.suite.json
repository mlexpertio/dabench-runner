          "completed_on": "2026-04-13",
          "replaced_parts": ["B-42", "F-8"],
          "technician": "Jo Tan"
        },
        "mode": "exact",
        "arrayOrder": "ordered",
        "extraction": "strict"
      }
    },
    {
      "id": "sample-header-lookup",
      "category": "coding",
      "tier": 2,
      "prompt": {
        "user": "Write JavaScript function getHeader(headers, name). Header names compare case-insensitively. If duplicate names exist, return the first value. Return null when absent. Do not mutate the input. Respond with code only."
      },
      "graderKind": "unit-test",
      "unitTests": {
        "entry": "getHeader",
        "cases": [
          {
            "name": "mixed-case",
            "args": [
              {
                "Content-Type": "text/plain"
              },
              "content-type"
            ],
            "expected": "text/plain"
          },
          {
            "name": "first-duplicate",
            "args": [
              {
                "X_ID": "first",
                "x_id": "second"
              },
              "x_id"
            ],
            "expected": "first"
          },
          {
            "name": "absent",
            "args": [
              {
                "Accept": "json"
              },
              "authorization"
            ],
            "expected": null
          },
          {
            "name": "empty",
            "args": [{}, "x-id"],
            "expected": null
          }
        ]
      }
    },
    {
      "id": "sample-merge-feature-overrides",
      "category": "coding",
      "tier": 2,
      "prompt": {
        "user": "Implement mergeFlags(defaults, overrides) in JavaScript. Return a new object with every default flag and every override flag. An override value replaces a default even when it is false. Do not mutate either input. Respond with code only."
      },
      "graderKind": "unit-test",
      "unitTests": {
        "entry": "mergeFlags",
        "cases": [
          {
            "name": "false-overrides-true",
            "args": [
              {
                "search": true
              },
              {
                "search": false
              }
            ],
            "expected": {
              "search": false
            }
          },
          {
            "name": "preserves-other-defaults",
            "args": [
              {
                "search": true,
                "export": false
              },
              {
                "search": false
              }
            ],
            "expected": {
              "search": false,
              "export": false
            }
          },
          {
            "name": "adds-new-flag",
            "args": [
              {
                "search": true
              },
              {
                "beta": true
              }
            ],
            "expected": {
              "search": true,
              "beta": true
            }
          },
          {
            "name": "empty",
            "args": [{}, {}],
            "expected": {}
          }
        ]
      }
    },
