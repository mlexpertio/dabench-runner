        "user": "Extract tracking_id, latest_status, latest_local_time, and exception_code from this carrier log. Use null for an absent exception. Return only JSON.\n\n09:12 | WX-731 | LABEL CREATED | depot A\n13:48 | WX-731 | IN TRANSIT | departed depot A\n13:52 | WX-730 | EXCEPTION E17 | address unclear\n16:06 | WX-731 | OUT FOR DELIVERY | route 4\nLog exported at 16:10 local time."
      },
      "graderKind": "json-match",
      "jsonMatch": {
        "expected": {
          "tracking_id": "WX-731",
          "latest_status": "OUT FOR DELIVERY",
          "latest_local_time": "16:06",
          "exception_code": null
        },
        "mode": "exact",
        "arrayOrder": "ordered",
        "extraction": "strict"
      }
    },
